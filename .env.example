# 本地默认仅绑定回环地址，数据库保存在 .data/lifelog.sqlite。
LIFELOG_MODE=demo
HOST=
PORT=3000
DEMO_DB_PATH=
CORS_ORIGINS=
TRUST_PROXY_HOPS=0

# 正式模式用已在 CloudBase PostgreSQL 中创建的 lifelog schema。
DATABASE_URL=
# PEM 内容或把换行写成 \n；使用系统信任链时留空。
DATABASE_SSL_CA=

# 两套应用凭据分别填写。安全模式使用 43 字符 EncodingAESKey。
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=
WECHAT_OA_TOKEN=
WECHAT_OA_MODE=safe
WECHAT_OA_ENCODING_AES_KEY=

# 实际公众号账户可调用素材下载时才打开。语音识别另行授权。
WECHAT_MEDIA_DOWNLOAD=false
WECHAT_VOICE_ASR=false
TENCENTCLOUD_ASR_REGION=ap-guangzhou
COS_BUCKET=
COS_REGION=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=
MEDIA_RETENTION_DAYS=30

# 与 CloudBase 定时云函数中的值一致，至少 32 字符。
INTERNAL_TICK_SECRET=

# Demo 无 API Key 使用明确标识的本地规则。正式模式填写兼容 Chat Completions 的服务。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_JSON_MODE=true
